+/// Persist status/category only: never request URLs, arguments or payloads.
+fn heimdall_http_diagnostic(category: &str, status: Option<u16>) {
+    ::zeroclaw_log::record!(
+        INFO,
+        ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Note)
+            .with_attrs(::serde_json::json!({"category": category, "http_status": status})),
+        "http_request diagnostic"
+    );
+}
+
+/// Only expose operational response header values. All other values are redacted.
+pub fn heimdall_response_headers(headers: &HeaderMap) -> String {
+    headers.iter().map(|(name, value)| {
+        let value = match name.as_str() {
+            "content-type" | "retry-after" | "x-ratelimit-limit" | "x-ratelimit-remaining"
+            | "x-ratelimit-reset" | "x-ratelimit-used" | "x-ratelimit-resource" =>
+                value.to_str().unwrap_or("[invalid header]"),
+            _ => "***REDACTED***",
+        };
+        format!("{name}: {value}")
+    }).collect::<Vec<_>>().join(", ")
+}
 
