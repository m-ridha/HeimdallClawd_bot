+/// Non-secret identity retained by a paired gateway connection. Stdio and
+/// explicitly unpaired transports retain their existing trusted behavior.
+#[derive(Clone)]
+struct ConnectionPairing {
+    pairing: Arc<zeroclaw_config::pairing::PairingGuard>,
+    token_hash: String,
+}
+
+impl ConnectionPairing {
+    fn hold(&self) -> Result<zeroclaw_config::pairing::HeldPairedTokens<'_>, RpcError> {
+        let held = self.pairing.hold_paired_tokens();
+        if !held.contains_hash(&self.token_hash) {
+            return Err(RpcError {
+                code: AUTH_REQUIRED,
+                message: "ACP pairing was revoked".to_string(),
+                data: None,
+            });
+        }
+        Ok(held)
+    }
+
+    async fn revoked(&self) {
+        self.pairing.wait_token_revoked(&self.token_hash).await;
+    }
+
+    /// Order the first poll of a turn before revocation, without holding a
+    /// synchronous pairing lock across an await. Once admitted, use native
+    /// cancellation so terminal transcript persistence still runs.
+    async fn run_turn<F: std::future::Future>(
+        &self,
+        turn: F,
+        cancel: tokio_util::sync::CancellationToken,
+    ) -> Result<F::Output, RpcError> {
+        let mut turn = std::pin::pin!(turn);
+        let first_poll = std::future::poll_fn(|cx| {
+            let _held = match self.hold() {
+                Ok(held) => held,
+                Err(error) => return std::task::Poll::Ready(Err(error)),
+            };
+            std::task::Poll::Ready(Ok(turn.as_mut().poll(cx)))
+        })
+        .await?;
+        if let std::task::Poll::Ready(result) = first_poll {
+            return Ok(result);
+        }
+        tokio::select! {
+            biased;
+            _ = self.revoked() => {
+                cancel.cancel();
+                Ok(turn.await)
+            }
+            result = &mut turn => Ok(result),
+        }
+    }
+}
+
+fn hold_connection_pairing(
+    pairing: Option<&ConnectionPairing>,
+) -> Result<Option<zeroclaw_config::pairing::HeldPairedTokens<'_>>, RpcError> {
+    pairing.map(ConnectionPairing::hold).transpose()
+}
