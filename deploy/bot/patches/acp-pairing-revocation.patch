+    async fn ws_chat_pairing_revocation_cancels_detached_turn_after_client_disconnect_inner() {
+        let token = "ws-chat-detached-token";
+        let (mut fixture, token_hash) = ParkedTurnFixture::spawn_paired(Some(token)).await;
+        let token_hash = token_hash.expect("paired token hash");
+        let session_id = "revocation-cancels-detached";
+        let session_key = format!("{GW_SESSION_PREFIX}{session_id}");
+        let url = format!(
+            "ws://{}/ws/chat?agent=web&session_id={session_id}&token={token}",
+            fixture.gateway_addr
+        );
+        let (mut client, _) = connect_async(url).await.expect("WebSocket upgrade");
+        let session_start = next_text_frame(&mut client).await;
+        assert_eq!(session_start["type"], "session_start");
+
+        let prompt = "keep working after disconnect until revoked";
+        fixture.start_parked_turn(&mut client, prompt).await;
+        assert!(fixture.has_live_turn(&session_key));
+
+        // Disconnect the client mid-turn: under ordinary disconnect the turn survives
+        disconnect_viewer(client).await;
+        assert!(fixture.has_live_turn(&session_key));
+
+        // Now revoke the pairing token while turn is running detached
+        assert!(fixture.state.pairing.revoke_token_hash(&token_hash));
+
+        // The detached turn must be cancelled and settle
+        fixture.wait_for_turn_to_settle(&session_key).await;
+        assert!(!fixture.has_live_turn(&session_key));
+
+        let transcript = fixture.backend.load(&session_key);
+        let interrupted =
+            zeroclaw_runtime::i18n::get_required_cli_string("turn-interrupted-by-user");
+        assert!(
+            transcript.iter().any(
+                |message| message.role == "assistant" && message.content.contains(&interrupted)
+            ),
+            "revoking a detached turn persists the interruption marker: {transcript:?}"
+        );
+        assert!(
+            !transcript
+                .iter()
+                .any(|message| message.content.contains(PARKED_TURN_RESPONSE)),
+            "the revoked turn never received the provider's response"
+        );
+
+        fixture.release_next();
+        fixture.shutdown();
+    }
