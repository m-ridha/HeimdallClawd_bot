+    #[tokio::test]
+    async fn heimdall_ws_chat_pairing_revocation_closes_connection_and_rejects_subsequent_turns() {
+        use futures_util::StreamExt as _;
+        use zeroclaw_config::pairing::{PairingCodePolicy, PairingGuard};
+        let mut config = zeroclaw_config::schema::Config::default();
+        config.gateway.require_pairing = true;
+        let agent = zeroclaw_config::schema::AliasedAgentConfig::default();
+        config.agents.insert("default".into(), agent);
+        let mut state = crate::api::test_state(config);
+        let token = "ws-chat-token";
+        let token_hash = PairingGuard::token_hash(token);
+        state.pairing = Arc::new(PairingGuard::new(
+            true,
+            &[token.to_string()],
+            PairingCodePolicy::default(),
+        ));
+        let app = Router::new()
+            .route("/ws/chat", get(handle_ws_chat))
+            .with_state(state.clone());
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let server = zeroclaw_spawn::spawn!(async move {
+            axum::serve(listener, app).await.unwrap();
+        });
+        let url = format!("ws://127.0.0.1:{port}/ws/chat?agent=default&token={token}");
+        let (mut ws, _) = connect_async(url).await.unwrap();
+        let frame = ws.next().await.unwrap().unwrap();
+        assert!(frame.to_text().unwrap().contains("session_start"));
+
+        // Revoke the token
+        assert!(state.pairing.revoke_token_hash(&token_hash));
+
+        // The socket should observe the revocation, send AUTH_REQUIRED error and close
+        let mut got_auth_required = false;
+        while let Some(Ok(msg)) = ws.next().await {
+            if let Ok(text) = msg.to_text() {
+                if text.contains("AUTH_REQUIRED") {
+                    got_auth_required = true;
+                    break;
+                }
+            }
+        }
+        assert!(got_auth_required, "expected AUTH_REQUIRED on revocation");
+
+        server.abort();
+    }
