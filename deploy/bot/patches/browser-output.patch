 use crate::helpers::domain_guard;
 
+/// Spawn the browser and collect bounded output while reading.
+/// stdout and stderr are drained concurrently; exceeding the 500 KiB stdout
+/// limit kills the child immediately without waiting for stderr EOF.
+/// kill_on_drop ensures cleanup when the caller drops on timeout or cancellation.
+async fn heimdall_browser_dump(
+    browser: &str,
+    args: &[String],
+) -> std::io::Result<std::process::Output> {
+    use tokio::io::AsyncReadExt;
+    let mut child = tokio::process::Command::new(browser)
+        .args(args)
+        .kill_on_drop(true)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()?;
+    let mut stdout_pipe = child.stdout.take().ok_or_else(|| std::io::Error::other("Browser stdout unavailable"))?;
+    let mut stderr_pipe = child.stderr.take().ok_or_else(|| std::io::Error::other("Browser stderr unavailable"))?;
+    let mut out = Vec::new();
+    let mut err = Vec::new();
+    let (out_result, err_result) = tokio::join!(
+        stdout_pipe.take(500_001).read_to_end(&mut out),
+        stderr_pipe.take(32_769).read_to_end(&mut err),
+    );
+    out_result?;
+    err_result?;
+    if out.len() > 500_000 {
+        child.kill().await?;
+        let _ = child.wait().await;
+        return Err(std::io::Error::other("Text browser output limit exceeded"));
+    }
+    let status = child.wait().await?;
+    Ok(std::process::Output { status, stdout: out, stderr: err })
+}
+
