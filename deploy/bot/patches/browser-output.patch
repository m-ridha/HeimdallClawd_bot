+/// Spawn the browser and collect bounded output while reading.
+/// stdout and stderr are drained concurrently. The stdout future returns an
+/// error as soon as it reads 500,001 bytes; tokio::try_join! cancels the
+/// stderr future immediately so the child is killed without waiting for
+/// stderr EOF. kill_on_drop handles cleanup on timeout or cancellation.
+#[doc(hidden)]
+pub async fn heimdall_browser_dump(
+    browser: &str,
+    args: &[String],
+    input: &[u8],
+) -> std::io::Result<std::process::Output> {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let mut child = tokio::process::Command::new(browser)
+        .args(args)
+        .kill_on_drop(true)
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()?;
+    let mut stdin_pipe = child
+        .stdin
+        .take()
+        .ok_or_else(|| std::io::Error::other("Browser stdin unavailable"))?;
+    let stdin_fut = async {
+        match stdin_pipe.write_all(input).await {
+            Err(error) if error.kind() != std::io::ErrorKind::BrokenPipe => return Err(error),
+            _ => {}
+        }
+        drop(stdin_pipe);
+        std::io::Result::Ok(())
+    };
+    let stdout_pipe = child
+        .stdout
+        .take()
+        .ok_or_else(|| std::io::Error::other("Browser stdout unavailable"))?;
+    let stderr_pipe = child
+        .stderr
+        .take()
+        .ok_or_else(|| std::io::Error::other("Browser stderr unavailable"))?;
+    let stdout_fut = async {
+        let mut out = Vec::new();
+        stdout_pipe.take(500_001).read_to_end(&mut out).await?;
+        if out.len() > 500_000 {
+            return Err(std::io::Error::other("Text browser output limit exceeded"));
+        }
+        std::io::Result::Ok(out)
+    };
+    let stderr_fut = async {
+        let mut err = Vec::new();
+        stderr_pipe.take(32_769).read_to_end(&mut err).await?;
+        std::io::Result::Ok(err)
+    };
+    match tokio::try_join!(stdout_fut, stderr_fut, stdin_fut) {
+        Ok((out, err, ())) => {
+            let status = child.wait().await?;
+            Ok(std::process::Output {
+                status,
+                stdout: out,
+                stderr: err,
+            })
+        }
+        Err(e) => {
+            child.kill().await?;
+            let _ = child.wait().await;
+            Err(e)
+        }
+    }
+}
