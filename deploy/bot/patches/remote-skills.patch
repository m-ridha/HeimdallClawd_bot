+    async fn heimdall_skill_scripts_use_remote_executor_even_with_host_commands_denied() {
+        struct Remote;
+        impl zeroclaw_api::attribution::Attributable for Remote {
+            fn role(&self) -> zeroclaw_api::attribution::Role {
+                zeroclaw_api::attribution::Role::Tool(zeroclaw_api::attribution::ToolKind::Plugin)
+            }
+            fn alias(&self) -> &str { "remote" }
+        }
+        #[async_trait]
+        impl Tool for Remote {
+            fn name(&self) -> &str { "workspace__bash" }
+            fn description(&self) -> &str { "test executor" }
+            fn parameters_schema(&self) -> serde_json::Value { serde_json::json!({}) }
+            async fn execute(&self, args: serde_json::Value) -> anyhow::Result<ToolResult> {
+                assert_eq!(args["command"], "lint --file example --format json");
+                Ok(ToolResult { success: true, output: "remote-only".into(), error: None })
+            }
+        }
+        let policy = Arc::new(SecurityPolicy { allowed_commands: vec![], ..SecurityPolicy::default() });
+        let tool = SkillShellTool::new("test", &sample_skill_tool(), policy).with_remote(Arc::new(Remote), None, None);
