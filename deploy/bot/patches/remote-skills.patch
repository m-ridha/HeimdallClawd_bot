+/// Copy only bounded regular text files; never follow a skill's symlinks into control state.
+fn heimdall_skill_files(root: &std::path::Path) -> anyhow::Result<Vec<(String, String)>> {
+    anyhow::ensure!(!std::fs::symlink_metadata(root)?.file_type().is_symlink(), "Skill root must not be a symlink");
+    let mut directories = vec![(root.to_path_buf(), 0usize)];
+    let mut files = Vec::new();
+    let mut bytes = 0usize;
+    while let Some((directory, depth)) = directories.pop() {
+        anyhow::ensure!(depth <= 8, "Skill directory nesting exceeds limit");
+        for entry in std::fs::read_dir(directory)? {
+            let entry = entry?;
+            if entry.file_name() == ".git" { continue; }
+            let kind = entry.file_type()?;
+            anyhow::ensure!(!kind.is_symlink(), "Skill symlinks cannot be copied");
+            if kind.is_dir() {
+                directories.push((entry.path(), depth + 1));
+                anyhow::ensure!(directories.len() <= 64, "Too many skill directories");
+            } else {
+                anyhow::ensure!(kind.is_file() && entry.metadata()?.len() <= 65536, "Skill copy accepts regular text files up to 64 KiB");
+                use std::io::Read;
+                use std::os::unix::fs::OpenOptionsExt;
+                let file = std::fs::OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK).open(entry.path())?;
+                anyhow::ensure!(file.metadata()?.is_file(), "Skill copy requires regular files");
+                let mut content = String::new();
+                file.take(65537).read_to_string(&mut content)?;
+                bytes += content.len();
+                anyhow::ensure!(content.len() <= 65536 && bytes <= 262144 && files.len() < 32, "Skill copy exceeds file or total size limit");
+                let relative = entry.path().strip_prefix(root)?.to_string_lossy().to_string();
+                files.push((relative, content));
+            }
+        }
+    }
+    Ok(files)
+}
