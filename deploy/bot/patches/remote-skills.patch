+    #[test]
+    fn heimdall_skill_copy_rejects_symlinks_and_oversized_files() {
+        let root = tempfile::tempdir().unwrap();
+        std::fs::write(root.path().join("run.sh"), "echo ready").unwrap();
+        assert_eq!(heimdall_skill_files(root.path()).unwrap().len(), 1);
+        std::os::unix::fs::symlink("/etc/passwd", root.path().join("escape")).unwrap();
+        assert!(heimdall_skill_files(root.path()).is_err());
+        std::fs::remove_file(root.path().join("escape")).unwrap();
+        std::fs::write(root.path().join("large"), vec![0; 65537]).unwrap();
+        assert!(heimdall_skill_files(root.path()).is_err());
     }
 
