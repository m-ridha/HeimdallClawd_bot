+/// Heimdall's named credentials are bound to exact TLS origins. Unknown aliases
+/// fail closed; credential-free requests retain the general public-host policy.
+pub fn heimdall_auth_origin(secret: &str, raw_url: &str) -> anyhow::Result<()> {
+    let host = match secret {
+        "github" => "api.github.com",
+        "agentmail" => "api.agentmail.to",
+        _ => anyhow::bail!("Named secret has no approved origin"),
+    };
+    let url = reqwest::Url::parse(raw_url)
+        .map_err(|_| anyhow::anyhow!("Invalid authenticated request URL"))?;
+    if url.scheme() != "https" || url.host_str() != Some(host)
+        || url.port_or_known_default() != Some(443)
+        || !url.username().is_empty() || url.password().is_some()
+    {
+        anyhow::bail!("Named secret is restricted to its approved HTTPS origin");
+    }
+    Ok(())
+}
