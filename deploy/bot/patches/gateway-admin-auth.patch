+        assert!(admin_request_is_local(
+            &loopback_peer(),
+            true,
+            &HeaderMap::new()
+        ));
+        assert!(admin_request_is_local(&loopback_peer(), false, &headers));
+        let error = handle_admin_reload(
+            State(state.clone()),
+            ConnectInfo(loopback_peer()),
+            headers.clone(),
+        )
+        .await
+        .err()
+        .unwrap();
+        assert_eq!(error.0, StatusCode::UNAUTHORIZED);
+        headers.extend(bearer_headers("invalid_fixture"));
+        let error = handle_admin_reload(
+            State(state.clone()),
+            ConnectInfo(loopback_peer()),
+            headers.clone(),
+        )
+        .await
+        .err()
+        .unwrap();
+        assert_eq!(error.0, StatusCode::UNAUTHORIZED);
+        headers.extend(bearer_headers(token));
+        let result = handle_admin_reload(
+            State(state.clone()),
+            ConnectInfo(loopback_peer()),
+            headers.clone(),
+        )
+        .await
+        .unwrap()
+        .into_response();
+        assert_eq!(result.status(), StatusCode::OK);
+        state.publish_test_config(|c| c.gateway.allow_remote_admin = false);
+        let error = handle_admin_reload(
+            State(state.clone()),
+            ConnectInfo(loopback_peer()),
+            headers.clone(),
+        )
+        .await
+        .err()
+        .unwrap();
+        assert_eq!(error.0, StatusCode::FORBIDDEN);
+        state.publish_test_config(|c| c.gateway.allow_remote_admin = true);
+        state.pairing.revoke_token(token);
+        let error =
+            handle_admin_reload(State(state), ConnectInfo(loopback_peer()), headers.clone())
+                .await
+                .err()
+                .unwrap();
+        assert_eq!(error.0, StatusCode::UNAUTHORIZED);
