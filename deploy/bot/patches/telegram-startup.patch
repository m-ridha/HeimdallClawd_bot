+        // Menu registration is idempotent. Shrink only on Telegram's explicit
+        // size rejection, never on auth, rate-limit, transport or other errors.
+        // Halving a set of at most 100 commands bounds this to seven requests.
+        loop {
+            let body = serde_json::json!({ "commands": commands });
+            match self
+                .http_client()
+                .post(&url)
+                .json(&body)
+                .timeout(Duration::from_secs(15))
+                .send()
+                .await
+            {
+                Ok(resp) if resp.status().is_success() => {
+                    ::zeroclaw_log::record!(
+                        INFO,
+                        ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Note)
+                            .with_attrs(serde_json::json!({"registered": commands.len()})),
+                        "Telegram bot commands registered successfully"
+                    );
+                    break;
+                }
+                Ok(mut resp) => {
+                    let status = resp.status();
+                    let mut bytes = Vec::new();
+                    // Error payloads are untrusted and never enter diagnostics.
+                    while let Ok(Some(chunk)) = resp.chunk().await {
+                        if bytes.len() + chunk.len() > 4096 {
+                            bytes.clear();
+                            break;
+                        }
+                        bytes.extend_from_slice(&chunk);
+                    }
+                    let rejection = serde_json::from_slice::<serde_json::Value>(&bytes).ok();
+                    let too_large = status == reqwest::StatusCode::BAD_REQUEST
+                        && rejection
+                            .as_ref()
+                            .and_then(|body| body["description"].as_str())
+                            == Some("Bad Request: BOT_COMMANDS_TOO_MUCH");
+                    if too_large && commands.len() > 1 {
+                        let previous_count = commands.len();
+                        commands.truncate(commands.len() / 2);
+                        ::zeroclaw_log::record!(
+                            WARN,
+                            ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Note)
+                                .with_attrs(serde_json::json!({"previous_count": previous_count, "next_count": commands.len()})),
+                            "Telegram command menu rejected by size; retrying a smaller menu"
+                        );
+                        continue;
+                    }
+                    ::zeroclaw_log::record!(
+                        WARN,
+                        ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Note)
+                            .with_outcome(::zeroclaw_log::EventOutcome::Failure)
+                            .with_attrs(serde_json::json!({"http_status": status.as_u16(), "registered": commands.len(), "size_rejected": too_large})),
+                        "Failed to register Telegram bot commands"
+                    );
+                    break;
+                }
+                Err(error) => {
+                    ::zeroclaw_log::record!(
+                        WARN,
+                        ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Note)
+                            .with_outcome(::zeroclaw_log::EventOutcome::Failure)
+                            .with_attrs(telegram_transport_diagnostic(&error)),
+                        "Failed to register Telegram bot commands"
+                    );
+                    break;
+                }
