+    #[tokio::test]
+    async fn heimdall_transport_diagnostic_omits_secret_urls() {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        let error = reqwest::Client::builder()
+            .no_proxy()
+            .timeout(Duration::from_millis(50))
+            .build()
+            .unwrap()
+            .get(format!(
+                "http://{address}/botfixture-private-token/getUpdates?secret=private-value"
+            ))
+            .send()
+            .await
+            .unwrap_err();
+        drop(listener);
+        let diagnostic = telegram_transport_diagnostic(&error);
+        assert_eq!(diagnostic["kind"], "timeout");
+        assert_eq!(diagnostic["phase"], "request");
+        let serialized = diagnostic.to_string();
+        for forbidden in [
+            "fixture-private-token",
+            "private-value",
+            "http://",
+            "getUpdates",
+        ] {
+            assert!(!serialized.contains(forbidden));
+        }
+    }
+    #[tokio::test]
+    async fn heimdall_username_rejection_retains_status_without_private_payload() {
+        let server = MockServer::start().await;
+        Mock::given(method("GET"))
+            .and(path("/bottest-token/getMe"))
+            .respond_with(ResponseTemplate::new(401).set_body_string("fixture-private-response"))
+            .mount(&server)
+            .await;
+        let channel = TelegramChannel::new("test-token".into(), "home", Arc::new(Vec::new), false)
+            .with_api_base(server.uri());
+        let mut error = channel.fetch_bot_username().await.unwrap_err();
+        let mut transport = error
+            .downcast_ref::<reqwest::Error>()
+            .expect("typed HTTP status");
+        for _ in 0..10 {
+            if transport.status().is_some() {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(50)).await;
+            error = channel.fetch_bot_username().await.unwrap_err();
+            transport = error
+                .downcast_ref::<reqwest::Error>()
+                .expect("typed HTTP status");
+        }
+        let diagnostic = telegram_transport_diagnostic(transport);
+        assert_eq!(diagnostic["http_status"], 401);
+        assert_eq!(diagnostic["kind"], "http_response");
+        assert_eq!(diagnostic["phase"], "http_response");
+        for forbidden in ["test-token", "fixture-private-response", "http://", "getMe"] {
+            assert!(!diagnostic.to_string().contains(forbidden));
+        }
+    }
+
+    #[tokio::test]
+    async fn heimdall_delayed_startup_probe_times_out_and_reaches_registration() {
+        use wiremock::matchers::body_partial_json;
+        use zeroclaw_api::channel::Channel;
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/bottest-token/getUpdates"))
+            .and(body_partial_json(serde_json::json!({"timeout":0})))
+            .respond_with(
+                ResponseTemplate::new(200)
+                    .set_body_json(serde_json::json!({"ok":true,"result":[]}))
+                    .set_delay(Duration::from_secs(60)),
+            )
+            .up_to_n_times(1)
+            .expect(1)
+            .with_priority(1)
+            .mount(&server)
+            .await;
+        Mock::given(method("POST"))
+            .and(path("/bottest-token/getUpdates"))
+            .respond_with(
+                ResponseTemplate::new(200)
+                    .set_body_json(serde_json::json!({"ok":true,"result":[]})),
+            )
+            .with_priority(2)
+            .mount(&server)
+            .await;
+        let registered = Arc::new(tokio::sync::Notify::new());
+        let notify = registered.clone();
+        Mock::given(method("POST"))
+            .and(path("/bottest-token/setMyCommands"))
+            .respond_with(move |_: &Request| {
+                notify.notify_one();
+                ResponseTemplate::new(200)
+                    .set_body_json(serde_json::json!({"ok":true,"result":true}))
+            })
+            .expect(1)
+            .mount(&server)
+            .await;
+        let channel = TelegramChannel::new("test-token".into(), "home", Arc::new(Vec::new), false)
+            .with_api_base(server.uri());
+        let (tx, _rx) = tokio::sync::mpsc::channel(1);
+        let listener = tokio::spawn(async move { channel.listen(tx).await });
+        // Includes the 15-second request deadline and native 5-second retry delay.
+        let outcome = tokio::time::timeout(Duration::from_secs(35), registered.notified()).await;
+        listener.abort();
+        assert!(listener.await.unwrap_err().is_cancelled());
+        assert!(
+            outcome.is_ok(),
+            "stalled startup probe never reached menu registration"
+        );
+    }
