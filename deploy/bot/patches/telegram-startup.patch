+#[cfg(test)]
+mod heimdall_startup_tests {
+    use super::*;
+    use wiremock::{
+        Mock, MockServer, Request, ResponseTemplate,
+        matchers::{method, path},
+    };
+
+    #[tokio::test]
+    async fn heimdall_command_menu_shrinks_only_after_explicit_size_rejection() {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/bottest-token/setMyCommands"))
+            .respond_with(|request: &Request| {
+                let body: serde_json::Value = serde_json::from_slice(&request.body).unwrap();
+                if body["commands"].as_array().unwrap().len() > 2 {
+                    ResponseTemplate::new(400).set_body_json(serde_json::json!({
+                        "ok": false, "error_code": 400,
+                        "description": "Bad Request: BOT_COMMANDS_TOO_MUCH"
+                    }))
+                } else {
+                    ResponseTemplate::new(200)
+                        .set_body_json(serde_json::json!({"ok":true,"result":true}))
+                }
+            })
+            .expect(3)
+            .mount(&server)
+            .await;
+        let channel = TelegramChannel::new("test-token".into(), "home", Arc::new(Vec::new), false)
+            .with_api_base(server.uri());
+        channel.register_bot_commands().await;
+        let requests = server.received_requests().await.unwrap();
+        let counts: Vec<usize> = requests
+            .iter()
+            .map(|request| {
+                let body: serde_json::Value = serde_json::from_slice(&request.body).unwrap();
+                body["commands"].as_array().unwrap().len()
+            })
+            .collect();
+        assert_eq!(counts, [6, 3, 1]);
+        let last: serde_json::Value = serde_json::from_slice(&requests[2].body).unwrap();
+        assert_eq!(last["commands"][0]["command"], "new");
+    }
+
+    #[tokio::test]
+    async fn heimdall_command_menu_does_not_retry_other_rejections() {
+        for (status, description) in [
+            (401, "Unauthorized"),
+            (429, "Too Many Requests"),
+            (400, "Bad Request: COMMAND_INVALID"),
+            (500, "BOT_COMMANDS_TOO_MUCH"),
+        ] {
+            let server = MockServer::start().await;
+            Mock::given(method("POST"))
+                .and(path("/bottest-token/setMyCommands"))
+                .respond_with(
+                    ResponseTemplate::new(status).set_body_json(serde_json::json!({
+                        "ok":false, "description":description
+                    })),
+                )
+                .expect(1)
+                .mount(&server)
+                .await;
+            let channel =
+                TelegramChannel::new("test-token".into(), "home", Arc::new(Vec::new), false)
+                    .with_api_base(server.uri());
+            channel.register_bot_commands().await;
+        }
+    }
+
+    #[tokio::test]
+    async fn heimdall_command_menu_stops_when_even_one_command_is_rejected() {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .respond_with(ResponseTemplate::new(400).set_body_json(serde_json::json!({
+                "ok":false, "description":"Bad Request: BOT_COMMANDS_TOO_MUCH"
+            })))
+            .expect(3)
+            .mount(&server)
+            .await;
+        let channel = TelegramChannel::new("test-token".into(), "home", Arc::new(Vec::new), false)
+            .with_api_base(server.uri());
+        channel.register_bot_commands().await;
+    }
+
+    #[tokio::test]
+    async fn heimdall_transport_diagnostic_omits_secret_urls() {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        drop(listener);
+        let error = reqwest::Client::builder()
+            .no_proxy()
+            .build()
+            .unwrap()
+            .get(format!(
+                "http://{address}/botfixture-private-token/getUpdates?secret=private-value"
+            ))
+            .send()
+            .await
+            .unwrap_err();
+        let diagnostic = telegram_transport_diagnostic(&error);
+        assert_eq!(diagnostic["kind"], "connect");
+        assert_eq!(diagnostic["phase"], "request");
+        let serialized = diagnostic.to_string();
+        for forbidden in [
+            "fixture-private-token",
+            "private-value",
+            "http://",
+            "getUpdates",
+        ] {
+            assert!(!serialized.contains(forbidden));
+        }
+    }
