+// Keep transport diagnostics actionable without retaining token-bearing URLs,
+// response bodies or arbitrary source-error strings.
+fn telegram_transport_diagnostic(error: &reqwest::Error) -> serde_json::Value {
+    use std::error::Error as _;
+    let kind = if error.is_status() {
+        "http_response"
+    } else if error.is_timeout() {
+        "timeout"
+    } else if error.is_connect() {
+        "connect"
+    } else if error.is_decode() {
+        "decode"
+    } else {
+        "request"
+    };
+    let mut source = error.source();
+    let mut io_kind = None;
+    for _ in 0..8 {
+        let Some(cause) = source else { break };
+        if let Some(io) = cause.downcast_ref::<std::io::Error>() {
+            io_kind = Some(format!("{:?}", io.kind()));
+            break;
+        }
+        source = cause.source();
+    }
+    serde_json::json!({
+        "kind": kind,
+        "phase": if error.is_status() { "http_response" } else if error.is_decode() { "response_body" } else { "request" },
+        "io_kind": io_kind,
+        "http_status": error.status().map(|status| status.as_u16()),
+        "hint": "check connectivity, DNS/TLS, proxy and platform egress; do not log request URLs"
+    })
 }

