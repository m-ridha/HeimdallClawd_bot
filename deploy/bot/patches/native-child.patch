+/// Output is bounded while reading, not after collecting an unbounded pipe.
+async fn heimdall_browser_dump(browser: &str, args: &[String]) -> std::io::Result<std::process::Output> {
+    let child = tokio::process::Command::new("/usr/local/bin/heimdall-launcher")
+        .arg("browser-child").arg(browser).args(args)
+        .env_clear().env("PATH", "/usr/bin:/bin").kill_on_drop(true)
+        .stdin(std::process::Stdio::null()).stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null()).spawn()?;
+    heimdall_browser_output(child).await
+}
+
+/// Bounded child-output contract shared by the browser and native regression tests.
+pub async fn heimdall_browser_output(mut child: tokio::process::Child) -> std::io::Result<std::process::Output> {
+    use tokio::io::AsyncReadExt;
+    let stdout = child.stdout.take().ok_or_else(|| std::io::Error::other("Browser output unavailable"))?;
+    let mut bytes = Vec::new();
+    stdout.take(500_001).read_to_end(&mut bytes).await?;
+    if bytes.len() > 500_000 {
+        child.kill().await?;
+        return Err(std::io::Error::other("Text browser output limit exceeded"));
+    }
+    let status = child.wait().await?;
+    Ok(std::process::Output { status, stdout: bytes, stderr: Vec::new() })
+}

