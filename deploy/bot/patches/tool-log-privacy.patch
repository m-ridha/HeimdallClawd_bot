+/// Apply the capture opt-out before terminal, export, broadcast or disk sinks.
+/// Unknown initialization state fails closed. Raw legacy arguments/results are
+/// never an alternative to the policy-controlled tool_input/tool_output path.
+pub(crate) fn filter_tool_payloads(attributes: &mut Value, is_tool: bool) {
+    let Some(fields) = attributes.as_object_mut() else {
+        return;
+    };
+    if !is_tool && !fields.contains_key("tool") {
+        return;
+    }
+    for key in ["input", "arguments", "result", "output", "error", "error_reason"] {
+        fields.remove(key);
+    }
+    let allowed = current_state().is_some_and(|state| {
+        state.policy.tool_io.captures_io()
+            && !fields
+                .get("tool")
+                .and_then(Value::as_str)
+                .is_some_and(|tool| state.policy.is_tool_denylisted(tool))
+    });
+    if !allowed {
+        for key in ["tool_input", "tool_output"] {
+            fields.remove(key);
+        }
+    }
+}
