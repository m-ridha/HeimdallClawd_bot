+#[cfg(test)]
+mod heimdall_private_tests {
+    #[tokio::test]
+    async fn heimdall_group_callbacks_cannot_approve_tools() {
+        use crate::util::PendingApproval;
+        let channel = TelegramChannel::new("test-token".into(), "home", Arc::new(|| vec!["1001".into()]), false)
+            .with_ack_reactions(false).with_api_base("http://127.0.0.1:9".into());
+        let (approval_tx,mut approval_rx)=tokio::sync::oneshot::channel();
+        channel.pending_approvals.lock().await.insert("private-only".into(),PendingApproval{sender:approval_tx,destination:"1001".into(),tool_name:"shell".into()});
+        for kind in ["group","supergroup",""] {
+            let update=serde_json::json!({"update_id":7,"callback_query":{"id":"cb","from":{"id":1001},"message":{"message_id":1,"chat":{"id":1001,"type":kind}},"data":"approval:private-only:approve"}});
+            let (tx,mut rx)=tokio::sync::mpsc::channel(1);let mut offset=0;let mut retry=None;
+            channel.process_update(&update,&tx,&mut offset,&mut retry).await;
+            assert_eq!(offset,8);assert!(rx.try_recv().is_err());
+            assert!(matches!(approval_rx.try_recv(),Err(tokio::sync::oneshot::error::TryRecvError::Empty)));
+        }
+        assert!(channel.pending_approvals.lock().await.contains_key("private-only"));
+    }
+
+    use super::*;
+    #[tokio::test]
+    async fn heimdall_reject_non_private_updates() {
+        let channel = TelegramChannel::new("test-token".into(), "home", Arc::new(|| vec!["1001".into()]), false)
+            .with_ack_reactions(false).with_api_base("http://127.0.0.1:9".into());
+        for kind in ["group", "supergroup", "channel", "", "unknown"] {
+            for field in ["text", "photo", "voice", "document"] {
+                let mut message = serde_json::json!({"message_id":1,"chat":{"id":-1,"type":kind},"from":{"id":1001,"first_name":"Owner"},"caption":"@fixture_assistant_bot test"});
+                message[field] = if field == "text" {serde_json::json!("test")} else if field == "photo" {serde_json::json!([{"file_id":"test","width":1,"height":1}])} else {serde_json::json!({"file_id":"test"})};
+                let update = serde_json::json!({"update_id":4,"message":message});
+                let (tx, mut rx) = tokio::sync::mpsc::channel(1);
+                let mut offset=0; let mut retry=None;
+                let outcome=channel.process_update(&update,&tx,&mut offset,&mut retry).await;
+                assert!(matches!(outcome,UpdateOutcome::Advanced));
+                assert_eq!(offset,5);
+                assert!(rx.try_recv().is_err(),"non-private {kind} {field} reached agent");
+            }
+        }
+    }
+    #[tokio::test]
+    async fn heimdall_private_authorization_is_preserved() {
+        let channel = TelegramChannel::new("test-token".into(), "home", Arc::new(|| vec!["1001".into()]), false)
+            .with_ack_reactions(false).with_api_base("http://127.0.0.1:9".into());
+        for (sender,allowed) in [(1001,true),(999999999,false)] {
+            let update=serde_json::json!({"update_id":1,"message":{"message_id":1,"chat":{"id":sender,"type":"private"},"from":{"id":sender,"first_name":"Test"},"text":"hello"}});
+            let (tx,mut rx)=tokio::sync::mpsc::channel(1); let mut offset=0;let mut retry=None;
+            channel.process_update(&update,&tx,&mut offset,&mut retry).await;
+            assert_eq!(rx.try_recv().is_ok(),allowed);
+        }
+    }
