+// Persisted or interrupted histories can contain calls whose results were lost.
+// Supply an explicit unknown outcome, never a fabricated success or a tool replay.
+fn complete_responses_tool_pairs(input: Vec<Value>) -> Vec<Value> {
+    let mut pending: Vec<String> = Vec::new();
+    let mut output = Vec::with_capacity(input.len());
+    let flush = |pending: &mut Vec<String>, output: &mut Vec<Value>| {
+        for id in pending.drain(..) {
+            output.push(serde_json::json!({
+                "type": "function_call_output", "call_id": id,
+                "output": "ERROR: Tool output is missing from retained history. Execution outcome is unknown; verify external state before retrying any action.",
+            }));
+        }
+    };
+    for item in input {
+        // A result from a later user turn must not resolve an earlier gap.
+        if response_item_type(&item) == Some("message") && item["role"] == "user" {
+            flush(&mut pending, &mut output);
+        }
+        if let Some(id) = item.get("call_id").and_then(Value::as_str) {
+            match response_item_type(&item) {
+                Some("function_call") => pending.push(id.to_owned()),
+                Some("function_call_output") => pending.retain(|pending_id| pending_id != id),
+                _ => {}
+            }
+        }
+        output.push(item);
+    }
+    flush(&mut pending, &mut output);
+    output
+}
