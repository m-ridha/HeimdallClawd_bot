+// A Responses SSE request-shape error cannot be repaired by replaying the same input.
+fn is_missing_tool_output(err: &anyhow::Error) -> bool {
+    err.chain().any(|cause| {
+        cause
+            .downcast_ref::<crate::openai_codex::ResponsesStreamApiError>()
+            .is_some_and(|cause| {
+                cause
+                    .0
+                    .starts_with("No tool output found for function call ")
+            })
+    })
+}
