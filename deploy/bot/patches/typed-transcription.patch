+#[cfg(test)]
+mod heimdall_typed_transcription_tests {
+    use super::*;
+    #[test]
+    fn heimdall_typed_deepgram_sets_limits_and_manager_together() {
+        let mut config: zeroclaw_config::schema::Config = serde_json::from_value(serde_json::json!({
+            "transcription":{"enabled":true,"max_audio_bytes":8388608,"max_duration_secs":120},
+            "providers":{"transcription":{"deepgram":{"voice":{"api_key":"synthetic-deepgram-fixture","model":"nova-3"}}}}
+        })).unwrap();
+        let channel = || TelegramChannel::new("fake-token".into(), "home", Arc::new(|| vec!["1001".into()]), false);
+        let configured = channel().with_transcription_for_provider(&config, "deepgram.voice");
+        assert_eq!(configured.transcription.as_ref().unwrap().max_duration_secs, 120);
+        assert_eq!(configured.transcription.as_ref().unwrap().max_audio_bytes, Some(8388608));
+        assert_eq!(configured.transcription_manager.as_ref().unwrap().available_providers(), ["deepgram.voice"]);
+        config.providers.transcription.deepgram.get_mut("voice").unwrap().base.api_key = None;
+        let missing_key = channel().with_transcription_for_provider(&config, "deepgram.voice");
+        assert!(missing_key.transcription.is_none() && missing_key.transcription_manager.is_none());
+        config.transcription.enabled = false;
+        let disabled = channel().with_transcription_for_provider(&config, "deepgram.voice");
+        assert!(disabled.transcription.is_none() && disabled.transcription_manager.is_none());
+    }
+}
