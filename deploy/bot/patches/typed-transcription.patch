+    /// Initialize limits and providers together, including typed-only configurations.
+    pub fn with_transcription_for_provider(
+        mut self,
+        config: &zeroclaw_config::schema::Config,
+        provider: &str,
+    ) -> Self {
+        if !config.transcription.enabled {
+            return self;
+        }
+        match super::transcription::TranscriptionManager::from_config_with_provider(
+            config, provider.to_string(),
+        ) {
+            Ok(manager) => {
+                self.transcription = Some(config.transcription.clone());
+                self.transcription_manager = Some(Arc::new(manager));
+            }
+            Err(_) => {
+                ::zeroclaw_log::record!(
+                    WARN,
+                    ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Note),
+                    "Voice transcription initialization failed; check the configured provider and credentials"
+                );
+            }
+        }
         self
     }

